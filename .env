# 标题
VITE_APP_TITLE=统一监管报送平台

# 项目本地运行端口号（上游默认 80，非 root 无法绑定，改为 5173）
VITE_PORT=5173

# open 运行 npm run dev 时自动打开浏览器
VITE_OPEN=false

# 租户开关（Demo 关闭多租户，简化登录链路）
VITE_APP_TENANT_ENABLE=false

# 验证码的开关（Demo 关闭，免验证码登录）
VITE_APP_CAPTCHA_ENABLE=false

# 文档地址的开关
VITE_APP_DOCALERT_ENABLE=false

# Mock 数据开关：true = 走浏览器本地 mock 数据（本 Demo 默认开启）
VITE_MOCK_ENABLE=true

# 百度统计：本 Demo 显式关闭（留空 = 不注入 hm.baidu.com 脚本，页面零外联）
# 原因：演示要给银行/保险客户看，页面不该往第三方发请求；离线环境也不再产生一次必然失败的外联。
# 实测：留空后 document.querySelectorAll('script[src]') 里不再出现 hm.baidu.com（见 README「交付与复制」一节）。
VITE_APP_BAIDU_CODE =

# 默认账户密码
VITE_APP_DEFAULT_LOGIN_TENANT = 芋道源码
VITE_APP_DEFAULT_LOGIN_USERNAME = admin
VITE_APP_DEFAULT_LOGIN_PASSWORD = admin123

# API 加解密
VITE_APP_API_ENCRYPT_ENABLE = true
VITE_APP_API_ENCRYPT_HEADER = X-Api-Encrypt
VITE_APP_API_ENCRYPT_ALGORITHM = AES
VITE_APP_API_ENCRYPT_REQUEST_KEY = 52549111389893486934626385991395
VITE_APP_API_ENCRYPT_RESPONSE_KEY = 96103715984234343991809655248883

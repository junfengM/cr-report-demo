# 本项目 pnpm 配置
# 说明：上游 yudao-ui-admin-vue3 的 pnpm-lock.yaml 中部分依赖的 tarball 地址指向
# registry.npmmirror.com。pnpm 11 的供应链策略会校验 lockfile 中的 tarball 域名
# 是否与当前 registry 元数据一致，不一致则直接拒绝安装（ERR_PNPM_TARBALL_URL_MISMATCH）。
# 因此这里显式把 registry 固定为 npmmirror，与 lockfile 保持一致。
registry=https://registry.npmmirror.com/

# 保留 lockfile 原样，不因安装而改写
prefer-frozen-lockfile=true
